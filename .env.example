# ──────────────────────────────────────────────
# Smart API Monitor — Environment Variables
# Copy this to .env and fill in your values
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=3000

# MongoDB
MONGO_URI=mongodb://localhost:27017/smart_api_monitor

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# REDIS_TLS=true   # Uncomment for TLS (e.g. Redis Cloud)

# Monitoring
# How often the scheduler checks for APIs due for pinging (in seconds)
SCHEDULER_INTERVAL_SECONDS=30

# Alert threshold — how many consecutive failures before an alert fires
ALERT_FAILURE_THRESHOLD=3

# Cache TTL for /stats and /logs responses (seconds)
CACHE_TTL_SECONDS=30

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Email (ready-structure — wire up nodemailer/SendGrid here)
ALERT_EMAIL_FROM=alerts@yourapp.com
ALERT_EMAIL_TO=oncall@yourapp.com
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
